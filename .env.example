MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=learnverse_tasks
PORT=3000
HOST=127.0.0.1
# Explicitly enable only when ready to connect a client.
MCP_ENABLED=false
# Set true behind a HTTPS reverse proxy in production.
COOKIE_SECURE=false
# Hosted browser origin, for example https://example.cloudfront.net.
# Leave empty for ordinary local development.
PUBLIC_ORIGIN=

# Optional password reset via SMTP. Gmail requires an app password.
RESET_EMAIL_TRANSPORT=smtp
RESET_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# AWS Lambda reads the encrypted JSON user/password from this SSM parameter.
SMTP_PARAMETER=
